{
  "name": "@umami/react-zen",
  "version": "0.251.0",
  "description": "Modern, minimalist React component library",
  "homepage": "https://zen.umami.is",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umami-software/react-zen.git"
  },
  "license": "MIT",
  "author": "Umami <hello@umami.is>",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "styles.full.css",
    "tailwind.preset.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./styles.full.css": "./styles.full.css",
    "./tailwind-preset": "./tailwind.preset.ts"
  },
  "scripts": {
    "build": "npm-run-all tsup css",
    "dev": "npm-run-all --parallel dev:tsup dev:css",
    "dev:tsup": "tsup --watch",
    "dev:css": "node css.mjs --watch",
    "lint": "biome check ./src",
    "icons": "svgr ./src/assets --out-dir src/components/svg --typescript",
    "css": "node css.mjs",
    "tsup": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-spring/web": "^9.7.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.555.0",
    "react-day-picker": "^9.11.1",
    "react-hook-form": "^7.66.1",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@hyrious/esbuild-plugin-commonjs": "^0.2.6",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@umami/esbuild-plugin-css-modules": "0.4.0",
    "autoprefixer": "^10.4.23",
    "dts-bundle": "^0.7.3",
    "esbuild": "^0.27.0",
    "esbuild-css-modules-plugin": "^3.1.5",
    "esbuild-plugin-svgr": "^3.1.1",
    "esbuild-postcss": "^0.0.4",
    "glob": "^13.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "react-hook-form": "^7.66.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
